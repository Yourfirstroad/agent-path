{
  "name": "agent-path",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5189 --strictPort",
    "build": "node scripts/export-curriculum.mjs && tsc -b && vite build",
    "build:pages": "node scripts/export-curriculum.mjs && tsc -b && vite build --mode pages",
    "publish:pages": "node scripts/publish-pages.mjs",
    "preview:pages": "vite preview --mode pages --host 127.0.0.1 --port 8111 --strictPort",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "test:cloud-db": "node scripts/test-cloud-db.mjs",
    "build:cloud-test": "node scripts/build-cloud-test.mjs",
    "test:cloud": "playwright test --config playwright.cloud.config.ts",
    "preview": "vite preview --host 127.0.0.1 --port 5189 --strictPort",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "starter": "node scripts/create-starter.mjs",
    "test:starter": "node scripts/test-starter.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "0.5.12",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.5"
  }
}
